@model MvcModelBindingApp.Models.User

<h2>Submitted User Details</h2>

<p>
    <b>First Name:</b> @Model.FirstName
</p>

<p>
    <b>Last Name:</b> @Model.LastName
</p>

<p>
    <b>Age:</b> @Model.Age
</p>

<h3>Address</h3>

<p>
    <b>Street:</b> @Model.Address.Street
</p>

<p>
    <b>City:</b> @Model.Address.City
</p>

<p>
    <b>Zip Code:</b> @Model.Address.ZipCode
</p>